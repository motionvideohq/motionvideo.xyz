{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motionvideo",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
  },
  // Prerendered content pages (STATIC_PAGES in src/constants/routes.ts) run the
  // Worker first so it can apply the www redirect, then it serves the static
  // HTML through ASSETS. Scripts, styles, and images skip the Worker.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/about",
      "/brand",
      "/contact",
      "/dpa",
      "/privacy",
      "/refunds",
      "/terms",
    ],
  },
  // Served only on the custom domains; auth is bound to BETTER_AUTH_URL.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "motionvideo.xyz", "custom_domain": true },
    { "pattern": "www.motionvideo.xyz", "custom_domain": true },
  ],
  // Non-secret production config. `.env` overrides these locally with test-mode
  // values. `pnpm dodo:setup --live` writes the live Dodo IDs below.
  // Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY, DODO_PAYMENTS_API_KEY,
  // DODO_PAYMENTS_WEBHOOK_KEY) are set with `wrangler secret put`.
  "vars": {
    "BETTER_AUTH_URL": "https://motionvideo.xyz",
    "EMAIL_FROM": "\"Aniket @ MotionVideo\" <hello@motionvideo.xyz>",
    "DODO_PAYMENTS_ENVIRONMENT": "live_mode",
    "DODO_PRODUCT_SKILL": "pdt_0NpNXaPWFYUJrFMSsud2d",
    "DODO_PRODUCT_SPONSOR_DIAMOND": "pdt_0NpNXaRMKrltVcSg5Fp4u",
    "DODO_PRODUCT_SPONSOR_GOLD": "pdt_0NpNXaSJzUiH9v10l0QNb",
    "DODO_PRODUCT_SPONSOR_SILVER": "pdt_0NpNXaTf7ZtRfRYuqmg9v",
    "DODO_LAUNCH_DISCOUNT_ID": "dsc_0NpNXaUrA1aatsq1xXVwH",
  },
  // Contact form: 3 messages per minute per IP.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motionvideo",
      "database_id": "c44471e8-d7d2-4005-8f95-1e12f0ee0ae8",
      "migrations_dir": "drizzle",
    },
  ],
}
