{
  "name": "motionvideo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "catalog:import": "node scripts/import-motion-catalog.mjs",
    "catalog:import:resources": "node scripts/import-resource-directories.mjs",
    "catalog:import:whatships": "node scripts/import-whatships-motion.mjs",
    "dodo:setup": "node scripts/setup-dodo.mjs",
    "preview": "vite preview",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "ultracite check",
    "typecheck": "wrangler types && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "auth:schema": "pnpm dlx auth@latest generate --config scripts/auth-schema.config.ts --output src/server/db/schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "email:dev": "email dev --dir src/emails --port 3001",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "assets:mirror": "node scripts/mirror-assets.mjs",
    "icons:duotone": "node scripts/vendor-reicon-duotone.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@better-auth/utils": "0.4.2",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "better-auth": "^1.7.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dodopayments": "^2.54.1",
    "drizzle-orm": "^0.45.3",
    "intlayer": "^9.7.0",
    "player.style": "^0.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.11.0",
    "react-intlayer": "^9.7.0",
    "reicon-react": "^1.2.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "torph": "^0.1.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@react-email/ui": "^6.11.0",
    "@shadcn/lint": "^0.2.0",
    "@tanstack/devtools-vite": "latest",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^6",
    "ultracite": "7.12.1",
    "vite": "^8",
    "vite-intlayer": "^9.7.0",
    "wrangler": "^4.142.0"
  }
}
