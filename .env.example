# Copy to `.env` for local development (`cp .env.example .env`).
# In production, set secrets with `pnpm wrangler secret put <NAME>`.

BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Leave empty in development to print emails to the dev server console.
RESEND_API_KEY=
EMAIL_FROM='"Aniket @ MotionVideo" <hello@motionvideo.xyz>'

# "production" (live) or "sandbox" (test org at sandbox.polar.sh).
POLAR_SERVER=production
# Organization access token from Polar → Settings → Developers.
POLAR_ACCESS_TOKEN=
# Signing secret of the Polar webhook endpoint (/api/webhook/polar).
POLAR_WEBHOOK_SECRET=
# Regular $49 product and archived product retained for historic buyers.
POLAR_PRODUCT_ID=
POLAR_LEGACY_PRODUCT_ID=
# API-only fixed $20 USD discount, max_redemptions=100, restricted to POLAR_PRODUCT_ID.
# Keep its ID stable: recreating it resets the campaign's redemption count.
POLAR_LAUNCH_DISCOUNT_ID=
