{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@/components/snap-cn/manifesto": [
        "./src/components/snap-cn/manifesto.tsx",
        "./src/launch/licensed-fallback.tsx"
      ],
      "@/components/snap-cn/lockup-reveal": [
        "./src/components/snap-cn/lockup-reveal.tsx",
        "./src/launch/licensed-fallback.tsx"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts"
  ]
}
