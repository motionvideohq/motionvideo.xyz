{
  "name": "@motionvideo/videos",
  "private": true,
  "type": "module",
  "scripts": {
    "fonts": "mkdir -p public/fonts && cp -R ../web/public/fonts/timeless public/fonts/",
    "prestudio": "pnpm fonts",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "film:capture": "node scripts/capture-film.mjs",
    "film:foley": "node scripts/film-foley.mjs",
    "film:preview": "pnpm fonts && node scripts/render-film.mjs",
    "film:render": "pnpm fonts && node scripts/capture-film.mjs --final && node scripts/render-film.mjs --final",
    "launch:render": "pnpm fonts && remotion render MotionVideoLaunch out/picture.mp4 --scale=1.5 --crf=16 --muted",
    "launch:audio:cues": "node --experimental-strip-types --no-warnings audio/write-cues.ts",
    "launch:audio:forge": "${EARSHOT:-$HOME/.local/share/earshot}/.venv/bin/python audio/forge_sfx.py",
    "launch:audio:mix": "${EARSHOT:-$HOME/.local/share/earshot}/.venv/bin/python -I ${EARSHOT:-$HOME/.local/share/earshot}/skills/real-sound/scripts/mix.py --root . --design audio/sounddesign.json --trace out/qa/adds.json",
    "launch:audio:mux": "node ${EARSHOT:-$HOME/.local/share/earshot}/skills/real-sound/scripts/mux.mjs --video out/picture.mp4 --audio out/audio/soundtrack.wav --out out/motionvideo-launch.mp4",
    "launch:build": "pnpm launch:render && pnpm launch:audio:cues && pnpm launch:audio:mix && pnpm launch:audio:mux",
    "og:render": "pnpm fonts && remotion render OgVideo out/og.mp4 --crf=24 --pixel-format=yuv420p --muted --overwrite",
    "samples:render": "node src/samples/render.mjs",
    "showcase:previews": "node scripts/render-previews.mjs"
  },
  "dependencies": {
    "@motionvideo/engine": "workspace:*",
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/tailwind-v4": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "culori": "^4.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.541",
    "tailwindcss": "^4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/react": "^19",
    "playwright": "^1.64.1",
    "typescript": "^5.9"
  }
}
